# Environment: development, staging, production
ENVIRONMENT=development
DEBUG=false

# Server Configuration
HOST=0.0.0.0
PORT=8000

# CORS Allowed Origins (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:4000
# Legacy alias:
web_origin=http://localhost:4000,http://localhost:5173,http://localhost:5174

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60

# Max Upload Size (bytes) - default 15MB
MAX_AUDIO_SIZE_BYTES=15728640

# AI Provider Credentials
# 1. Primary: Google Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# 2. Fallback: Groq Cloud API
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# 3. Speech-to-Text: Gnani Prisma STT
GNANI_API_KEY=
GNANI_API_URL=https://api.vachana.ai/stt/v3
