# Comma-separated frontend origins (scheme + host only).
web_origin=http://localhost:4000,http://localhost:5173,http://localhost:5174

# Set at least one reply-generation provider key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Required only for voice-note transcription.
GNANI_API_KEY=
